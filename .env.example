DATABASE_URL="file:./dev.db"

# Local model only: OLLAMA_BASE_URL must be a loopback address (localhost / 127.0.0.1 / ::1).
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# llama3.2 (3B) is the minimum; a 7-8B instruct model (e.g. qwen2.5:7b) reasons noticeably better.
AI_MODEL="llama3.2:latest"
# Optional per-agent overrides, e.g.:
# AI_MODEL_DETECTIVE="qwen2.5:7b"
# AI_TIMEOUT_MS="180000"
# OLLAMA_STRUCTURED_OUTPUTS="true"

# The single evaluation clock (starter-pack evaluation date).
DEMO_EVALUATION_DATE="2026-10-14"

# Thresholds (days) — assumptions awaiting Business Owner confirmation.
# STALE_AFTER_DAYS="7"
# FOLLOW_UP_AFTER_DAYS="3"
# REMINDER_AFTER_DAYS="3"
# ESCALATE_AFTER_DAYS="7"
