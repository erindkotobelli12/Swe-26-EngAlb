generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Demo login identity. `role` is the account's primary persona (PMO | HR | ADDITIONAL_MANAGER | LINE_MANAGER | TECH_LEAD | EMPLOYEE).
// PMO and HR are organisation-level roles. Project roles come from ProjectAssignment rows, so permissions are
// resolved from role + relationship + phase (src/modules/permissions.ts), never from this column alone.
model User {
  id         String     @id
  name       String
  email      String     @unique
  role       String
  employee   Employee?  @relation(fields: [employeeId], references: [id])
  employeeId String?    @unique
  personId   String?    @unique
  person     Person?    @relation(fields: [personId], references: [id])
  audited    AuditLog[]
}

// A person with a profile. Only names present in the starter pack are seeded as starter-pack people; anyone else is
// either a role-only record (name = null) or a clearly labelled sample person (isSimulated = true).
// role (primary / organisation role): EMPLOYEE | LINE_MANAGER | TECH_LEAD | ADDITIONAL_MANAGER | KT_OWNER | PMO | HR |
//   ACCESS_SUPPORT | APP_OWNER | TECH_MANAGER | PROJECT_MANAGER
model Person {
  id          String              @id
  name        String?
  role        String
  projectId   String?
  project     Project?            @relation(fields: [projectId], references: [id])
  isSimulated Boolean             @default(false)
  note        String?
  employee    Employee?
  user        User?
  assignments ProjectAssignment[] @relation("AssignmentPerson")
  reports     ProjectAssignment[] @relation("AssignmentReportsTo")
  skills      EmployeeSkill[]
}

// The onboarding-case anchor. Each employee is a Person (personId) with a profile; `name` keeps the tracker's verbatim name.
model Employee {
  id              String                @id
  name            String
  personId        String?               @unique
  person          Person?               @relation(fields: [personId], references: [id])
  startDate       String
  movement        String
  projectId       String?
  project         Project?              @relation(fields: [projectId], references: [id])
  manager         String?
  lineManagerId   String?
  trackerStatus   String
  lastUpdate      String
  role            String?
  technicalLeadId String?
  isSimulated     Boolean               @default(false)
  updatedAt       DateTime              @default(now()) @updatedAt
  case            OnboardingCase?
  access          AccessRequest[]
  activities      KTActivity[]
  evidence        Evidence[]
  actions         ActionItem[]
  assessments     ReadinessAssessment[]
  preboarding     PreboardingItem[]
  requirementStatuses EmployeeRequirementStatus[]
  user            User?
}

// A pre-boarding checklist item (template in src/config/preboarding.ts). Credentials are never stored.
// category: HR_ADMIN | EQUIPMENT | ACCESS_REQUEST | WELCOME | CONTACTS; ownerRole: HR | LINE_MANAGER
// status: TODO | IN_PROGRESS | DONE | BLOCKED | NOT_APPLICABLE
model PreboardingItem {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  templateKey   String?
  title         String
  category      String
  ownerRole     String
  status        String   @default("TODO")
  blockerReason String?
  note          String?
  dueDate       String?
  sortOrder     Int      @default(0)
  evidenceId    String?
  updatedBy     String
  updatedAt     String

  @@unique([employeeId, templateKey])
}

// status: ACTIVE | CLOSED
model Project {
  id          String              @id
  name        String
  code        String?
  description String?
  startDate   String?
  status      String              @default("ACTIVE")
  isSimulated Boolean             @default(false)
  createdById String?
  createdAt   String?
  employees   Employee[]
  evidence    Evidence[]
  resources   KnowledgeResource[]
  people      Person[]
  assignments ProjectAssignment[]
  requirements OnboardingRequirement[]
}

// Skill catalogue. category: APPLICATION | TECHNICAL | DOMAIN | PROCESS
model Skill {
  id             String                  @id
  name           String                  @unique
  category       String
  description    String                  @default("")
  employeeSkills EmployeeSkill[]
  requirements   OnboardingRequirement[]
}

// A skill on a person's profile. Only CONFIRMED skills count for automatic requirement check-off; a self-declared skill
// stays CLAIMED until a Technical Lead confirms it. level: BASIC | INTERMEDIATE | ADVANCED
// source: SELF_DECLARED | TL_CONFIRMED | PREVIOUS_PROJECT | ASSESSMENT; status: CLAIMED | CONFIRMED | REJECTED
model EmployeeSkill {
  id            String  @id @default(cuid())
  personId      String
  person        Person  @relation(fields: [personId], references: [id])
  skillId       String
  skill         Skill   @relation(fields: [skillId], references: [id])
  level         String
  source        String
  status        String  @default("CLAIMED")
  projectId     String?
  evidenceId    String?
  confirmedById String?
  confirmedAt   String?
  note          String?
  isSimulated   Boolean @default(false)
  createdAt     String
  updatedAt     String?

  @@unique([personId, skillId])
}

// What employees need for onboarding on a project, defined by the project's Technical Lead.
// type: SKILL | KT_ACTIVITY | ACCESS | DOCUMENT; status: ACTIVE | RETIRED
model OnboardingRequirement {
  id                 String                      @id @default(cuid())
  projectId          String
  project            Project                     @relation(fields: [projectId], references: [id])
  title              String
  description        String                      @default("")
  type               String
  skillId            String?
  skill              Skill?                      @relation(fields: [skillId], references: [id])
  requiredLevel      String?
  completionCriteria String
  mandatory          Boolean                     @default(true)
  status             String                      @default("ACTIVE")
  createdById        String
  createdAt          String
  updatedAt          String?
  statuses           EmployeeRequirementStatus[]
}

// One employee's progress on one requirement. SATISFIED_BY_EXISTING_SKILL is set only by the deterministic check-off rule
// (src/modules/requirements/checkoff.ts) and can be undone by the Technical Lead with a reason (checkoffUndone).
// status: TODO | IN_PROGRESS | DONE | SATISFIED_BY_EXISTING_SKILL | WAIVED
model EmployeeRequirementStatus {
  id                 String                @id @default(cuid())
  employeeId         String
  employee           Employee              @relation(fields: [employeeId], references: [id])
  requirementId      String
  requirement        OnboardingRequirement @relation(fields: [requirementId], references: [id])
  status             String                @default("TODO")
  satisfiedBySkillId String?
  checkoffUndone     Boolean               @default(false)
  decidedById        String?
  decidedAt          String?
  note               String?

  @@unique([employeeId, requirementId])
}

// A person's role on a project. Never hard-deleted: removal sets status REMOVED (or COMPLETED) with an end date, and is audited.
// role: ADDITIONAL_MANAGER | LINE_MANAGER | TECH_LEAD | EMPLOYEE. One person may hold several roles on one project
// (e.g. Line Manager and Technical Lead). Reporting line: Employee → Line Manager → Additional Manager (reportsToPersonId).
// status: ACTIVE | COMPLETED | REMOVED
model ProjectAssignment {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id])
  personId          String
  person            Person   @relation("AssignmentPerson", fields: [personId], references: [id])
  role              String
  reportsToPersonId String?
  reportsTo         Person?  @relation("AssignmentReportsTo", fields: [reportsToPersonId], references: [id])
  assignedById      String
  assignedAt        String
  startDate         String?
  endDate           String?
  status            String   @default("ACTIVE")
  movement          String?
  endReason         String?
  isSimulated       Boolean  @default(false)

  @@index([projectId, role, status])
  @@index([personId, status])
}

// phase: PRE_BOARDING | ONBOARDING | READY | CLOSED — separate from readiness level and reliability.
// Only humans change phase (hand-over by the Line Manager; READY only through a Technical Lead's validation).
model OnboardingCase {
  id                String                @id
  employeeId        String                @unique
  employee          Employee              @relation(fields: [employeeId], references: [id])
  phase             String                @default("ONBOARDING")
  phaseChangedAt    String?
  phaseChangedBy    String?
  assessedStatus    String                @default("UNKNOWN")
  validatedStatus   String                @default("UNKNOWN")
  riskFlags         String                @default("[]")
  assessmentReason  String?
  assessmentAt      String?
  ktOwnerId         String?
  expectedReadyAt   String?
  readinessReviewAt String?
  gatesJson         String                @default("[]")
  reliability       String?
  roadmapBaselineJson String?
  roadmapBaselineAt   String?
  roadmapBaselineBy   String?
  lastRecomputedAt  String?
  updatedAt         DateTime              @default(now()) @updatedAt
  findings          Finding[]
  validations       ReadinessValidation[]
  actions           ActionItem[]
  evidence          Evidence[]
  dependencies      Dependency[]
}

// status: NOT_REQUESTED | REQUESTED | APPROVAL_PENDING | APPROVED | PROVISIONED | USABLE | REJECTED. Only USABLE satisfies an access gate.
// Credentials are never stored anywhere.
model AccessRequest {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id])
  application       String
  requiredScope     String
  requestDate       String?
  owner             String?
  ownerPersonId     String?
  handlerRole       String?
  approverRole      String?
  required          Boolean  @default(true)
  status            String
  blockerReason     String?
  evidenceId        String?
  requestEvidenceId String?
  usableConfirmedAt String?
  usableEvidenceId  String?
  lastUpdate        String?
  nextFollowUp      String?
  requirementId     String?
  updatedAt         DateTime @default(now()) @updatedAt
}

// stage: NOT_STARTED | SHADOWING | SUPPORTED_EXECUTION | INDEPENDENT_EXECUTION
// stageBasis: OBSERVED (technical owner/KT owner) | SELF_REPORTED | REPORTED (tracker/other) | ASSESSMENT | UNKNOWN
// status: PROPOSED (template/AI, not yet a requirement) | CONFIRMED | REJECTED
model KTActivity {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  title            String
  description      String
  scope            String
  scopeType        String   @default("CORE")
  owner            String?
  ownerPersonId    String?
  stage            String   @default("NOT_STARTED")
  stageBasis       String   @default("UNKNOWN")
  evidenceId       String?
  completionDate   String?
  validation       String   @default("PENDING")
  requiredForReady Boolean  @default(true)
  requiredApps     String   @default("[]")
  requirementId    String?
  status           String   @default("CONFIRMED")
  origin           String   @default("EVIDENCE")
  originNote       String?
  updatedAt        DateTime @default(now()) @updatedAt
}

// Evidence is stored verbatim and never mutated after ingestion.
model Evidence {
  id             String          @id
  sourceType     String
  author         String?
  senderRole     String?
  senderPersonId String?
  recipients     String          @default("[]")
  authorityLevel String?
  timestamp      String
  content        String
  employeeId     String?
  employee       Employee?       @relation(fields: [employeeId], references: [id])
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id])
  caseId         String?
  case           OnboardingCase? @relation(fields: [caseId], references: [id])
  title          String
  sourceRef      String?
  reviewStatus   String          @default("PENDING_REVIEW")
  inReplyToId    String?
  isRequest      Boolean         @default(false)
  ingestedAt     String?
  ingestedBy     String?
  isSimulated    Boolean         @default(false)
  claims         EvidenceClaim[]
}

// A structured statement proposed from evidence. Approval applies it through a whitelisted field mapper.
model EvidenceClaim {
  id              String   @id @default(cuid())
  evidenceId      String
  evidence        Evidence @relation(fields: [evidenceId], references: [id])
  entity          String
  field           String
  extractedValue  String
  editedValue     String?
  excerpt         String
  excerptVerified Boolean  @default(false)
  effectiveDate   String?
  origin          String   @default("AI")
  aiRunId         String?
  reviewStatus    String   @default("PENDING")
  reviewReason    String?
  reviewerId      String?
  reviewedAt      String?
  appliedChange   String?
}

// status: OPEN | PROPOSED (AI, awaiting human) | RESOLVED | DISMISSED
model Finding {
  id                   String       @id
  caseId               String
  case                 OnboardingCase @relation(fields: [caseId], references: [id])
  fingerprint          String?
  type                 String
  category             String       @default("OTHER")
  origin               String       @default("RULE")
  severity             String
  title                String
  description          String
  status               String       @default("OPEN")
  evidenceIds          String       @default("[]")
  facts                String       @default("[]")
  assumptions          String       @default("[]")
  rootCauses           String       @default("[]")
  recommendedActions   String       @default("[]")
  affectedEntities     String       @default("[]")
  ownerRole            String?
  aiRunId              String?
  aiAnalysis           String?
  firstDetectedAt      String?
  lastDetectedAt       String?
  resolvedAt           String?
  resolvedBy           String?
  resolutionType       String?
  resolution           String?
  resolutionEvidenceId String?
  actions              ActionItem[]

  @@unique([caseId, fingerprint])
}

model ActionItem {
  id            String          @id @default(cuid())
  caseId        String?
  case          OnboardingCase? @relation(fields: [caseId], references: [id])
  employeeId    String?
  employee      Employee?       @relation(fields: [employeeId], references: [id])
  findingId     String?
  finding       Finding?        @relation(fields: [findingId], references: [id])
  title         String
  description   String
  ownerRole     String?
  ownerName     String?
  ownerPersonId String?
  priority      String          @default("MEDIUM")
  dueDate       String?
  status        String          @default("OPEN")
  evidenceIds   String          @default("[]")
  draft         String?
  origin        String          @default("HUMAN")
  createdBy     String?
  createdAt     String?
  resolvedAt    String?
}

model ReadinessAssessment {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  status      String
  explanation String
  evidenceIds String   @default("[]")
  gatesJson   String   @default("[]")
  trigger     String?
  timestamp   String
}

// Only a human TECH_LEAD may create these (enforced in src/server/actions/validation.ts). AI modules have no import path to it.
model ReadinessValidation {
  id             String         @id @default(cuid())
  caseId         String
  case           OnboardingCase @relation(fields: [caseId], references: [id])
  state          String         @default("PENDING")
  validatedLevel String?
  reviewerRole   String?
  reviewerName   String?
  reviewerId     String?
  evidenceId     String?
  evidenceIds    String         @default("[]")
  comment        String?
  timestamp      String?
}

model KnowledgeResource {
  id              String   @id
  title           String
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id])
  owner           String
  description     String
  location        String
  applicableRoles String   @default("[]")
  copyAllowed     Boolean  @default(true)
  sourceEvidenceId String?
}

// Directed edge in a case's dependency graph (employeeId null = project template).
// kind: REQUIRES | ENABLES | BLOCKS; status: PROPOSED | CONFIRMED | REJECTED; origin: RULE | TEMPLATE | AI | HUMAN.
// Only CONFIRMED edges affect calculations.
model Dependency {
  id          String          @id @default(cuid())
  employeeId  String?
  caseId      String?
  case        OnboardingCase? @relation(fields: [caseId], references: [id])
  fromType    String
  fromId      String
  toType      String
  toId        String
  kind        String          @default("REQUIRES")
  status      String          @default("PROPOSED")
  origin      String          @default("TEMPLATE")
  rationale   String
  evidenceIds String          @default("[]")
  excerpts    String          @default("[]")
  aiRunId     String?
  confirmedBy String?
  confirmedAt String?
  createdAt   String?

  @@unique([employeeId, fromType, fromId, toType, toId])
}

// A consolidated follow-up to one stakeholder on one channel. Never really sent: "send" puts it in a simulated outbox.
// status: DRAFT | APPROVED | SENT_SIMULATED | RESPONDED | CLOSED. draftOrigin: TEMPLATE | AI | HUMAN_EDITED.
model Communication {
  id                       String  @id @default(cuid())
  stakeholderKey           String
  stakeholderRole          String
  stakeholderPersonId      String?
  stakeholderLabel         String
  channel                  String
  subject                  String
  body                     String
  itemsJson                String  @default("[]")
  employeeIds              String  @default("[]")
  requestEvidenceIds       String  @default("[]")
  outboxEvidenceIds        String  @default("[]")
  status                   String  @default("DRAFT")
  priorityScore            Int     @default(0)
  escalationLevel          Int     @default(0)
  escalationRecommendation String?
  draftOrigin              String  @default("TEMPLATE")
  aiRunId                  String?
  responseEvidenceId       String?
  createdAt                String
  createdBy                String
  approvedBy               String?
  approvedAt               String?
  sentAt                   String?
  respondedAt              String?
  closedAt                 String?
}

// A roadmap proposal or approved plan item on top of the deterministic backbone.
// type: ADD | ALTERNATIVE | SKIP; kind: KT | ALTERNATIVE | LOGISTICS | OWNERSHIP; status: PROPOSED | APPROVED | REJECTED.
model RoadmapItem {
  id                 String  @id @default(cuid())
  employeeId         String
  type               String
  kind               String
  phase              Int
  title              String
  description        String
  ownerRole          String
  completionCriteria String
  relatesToKey       String?
  rationale          String
  evidenceIds        String  @default("[]")
  status             String  @default("PROPOSED")
  origin             String  @default("AI")
  aiRunId            String?
  createdAt          String
  decidedBy          String?
  decidedAt          String?
  decisionReason     String?
}

// A role-specific management briefing. Every statement carries refs (finding:/evidence:/action:) validated server-side.
// narrativeSource: AI (validated AI narrative) | DETERMINISTIC (AI unavailable or rejected; rule-generated statements).
// scopeKey: "ALL" (the author's whole scope) or "project:<id>" (one project). generatedById: the author's account.
model Briefing {
  id              String  @id @default(cuid())
  role            String
  scopeKey        String  @default("ALL")
  generatedAt     String
  generatedBy     String
  generatedById   String?
  evaluationDate  String
  sectionsJson    String
  snapshotJson    String
  narrativeSource String
  aiRunId         String?
  aiError         String?
  rejectedCount   Int     @default(0)
}

// AI transparency log: every agent call, cached by inputHash. inputRefs holds IDs only.
model AIRun {
  id            String @id @default(cuid())
  agent         String
  promptVersion String
  model         String
  inputHash     String
  inputRefs     String @default("[]")
  employeeId    String?
  output        String?
  status        String
  error         String?
  durationMs    Int    @default(0)
  createdAt     String

  @@index([agent, inputHash])
}

model AuditLog {
  id         String  @id @default(cuid())
  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id])
  actorLabel String?
  action     String
  entityType String
  entityId   String
  employeeId String?
  before     String?
  after      String?
  evidenceIds String @default("[]")
  details    String
  timestamp  String
}

// An improvement the PMO drives from insights or briefings. Only humans create or approve improvements; AI suggestions
// can only pre-fill the form. projectId null = organisation-wide. refs: JSON list of "case:<id>", "finding:<id>", "figure:<key>".
// source: INSIGHT | BRIEFING | MANUAL; status: PROPOSED | APPROVED | IN_PROGRESS | DONE | DROPPED
model Improvement {
  id            String  @id @default(cuid())
  projectId     String?
  title         String
  description   String
  source        String
  refs          String  @default("[]")
  ownerPersonId String?
  status        String  @default("PROPOSED")
  createdById   String
  createdAt     String
  approvedById  String?
  approvedAt    String?
  dueDate       String?
  outcomeNote   String?
  updatedAt     String?
}
