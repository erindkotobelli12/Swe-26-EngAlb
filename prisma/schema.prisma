generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  name      String
  email     String   @unique
  role      String
  employee  Employee? @relation(fields: [employeeId], references: [id])
  employeeId String? @unique
  audited   AuditLog[]
}

model Employee {
  id          String @id
  name        String
  startDate   String
  movement    String
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  manager     String?
  trackerStatus String
  lastUpdate  String
  role        String?
  technicalLeadId String?
  case        OnboardingCase?
  access      AccessRequest[]
  activities  KTActivity[]
  evidence    Evidence[]
  actions     ActionItem[]
  assessments ReadinessAssessment[]
  user        User?
}

model Project {
  id        String @id
  name      String
  employees Employee[]
  evidence  Evidence[]
  resources KnowledgeResource[]
}

model OnboardingCase {
  id               String @id
  employeeId       String @unique
  employee         Employee @relation(fields: [employeeId], references: [id])
  assessedStatus   String @default("UNKNOWN")
  validatedStatus  String @default("UNKNOWN")
  riskFlags        String @default("[]")
  assessmentReason String?
  assessmentAt     String?
  ktOwnerId        String?
  expectedReadyAt  String?
  readinessReviewAt String?
  findings         Finding[]
  validations      ReadinessValidation[]
  actions          ActionItem[]
  evidence         Evidence[]
}

model AccessRequest {
  id            String @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  application   String
  requiredScope String
  requestDate   String?
  owner         String?
  status        String
  blockerReason String?
  evidenceId    String?
  lastUpdate    String?
  nextFollowUp  String?
}

model KTActivity {
  id              String @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  title           String
  description     String
  scope           String
  owner           String?
  stage           String @default("NOT_STARTED")
  evidenceId      String?
  completionDate  String?
  validation      String @default("PENDING")
  requiredForReady Boolean @default(true)
}

model Evidence {
  id            String @id
  sourceType    String
  author        String?
  timestamp     String
  content       String
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])
  caseId        String?
  case          OnboardingCase? @relation(fields: [caseId], references: [id])
  title         String
  sourceRef     String?
  claims        EvidenceClaim[]
}

model EvidenceClaim {
  id              String @id @default(cuid())
  evidenceId      String
  evidence        Evidence @relation(fields: [evidenceId], references: [id])
  entity          String
  field           String
  extractedValue  String
  excerpt         String
  effectiveDate   String?
  reviewStatus    String @default("PENDING")
  reviewerId      String?
  reviewedAt      String?
}

model Finding {
  id          String @id
  caseId      String
  case        OnboardingCase @relation(fields: [caseId], references: [id])
  type        String
  severity    String
  title       String
  description String
  status      String @default("OPEN")
  evidenceIds String @default("[]")
  resolvedAt  String?
  resolution  String?
  actions     ActionItem[]
}

model ActionItem {
  id          String @id @default(cuid())
  caseId      String?
  case        OnboardingCase? @relation(fields: [caseId], references: [id])
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  findingId   String?
  finding     Finding? @relation(fields: [findingId], references: [id])
  title       String
  description String
  ownerRole   String?
  ownerName   String?
  priority    String @default("MEDIUM")
  dueDate     String?
  status      String @default("OPEN")
  evidenceIds String @default("[]")
  draft       String?
  resolvedAt  String?
}

model ReadinessAssessment {
  id         String @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  status     String
  explanation String
  evidenceIds String @default("[]")
  timestamp  String
}

model ReadinessValidation {
  id         String @id @default(cuid())
  caseId     String
  case       OnboardingCase @relation(fields: [caseId], references: [id])
  state      String @default("PENDING")
  reviewerRole String?
  reviewerName String?
  evidenceId String?
  comment    String?
  timestamp  String?
}

model KnowledgeResource {
  id       String @id
  title    String
  projectId String?
  project  Project? @relation(fields: [projectId], references: [id])
  owner    String
  description String
  location String
  applicableRoles String @default("[]")
}

model AuditLog {
  id        String @id @default(cuid())
  actorId   String?
  actor     User? @relation(fields: [actorId], references: [id])
  action    String
  entityType String
  entityId  String
  details   String
  timestamp String
}
